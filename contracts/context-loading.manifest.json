{
  "version": 1,
  "description": "ShitPM Design / PRD 编译式上下文装载清单。规范性规则由显式 pack 和稳定章节标记选择，不使用相似度检索决定强制装载。",
  "stages": {
    "align": {
      "passes": {
        "analysis": [
          "align-core"
        ]
      },
      "packs": {
        "align-core": {
          "purpose": "需求事实形成、材料详细保留、问答写回和高影响未知处理",
          "sections": [
            "align-writing-core",
            "align-writing-detail",
            "align-template"
          ]
        }
      }
    },
    "design": {
      "passes": {
        "analysis": [
          "design-core",
          "design-mode"
        ],
        "challenge": [
          "design-core",
          "design-mode",
          "design-cards"
        ],
        "writing": [
          "design-core",
          "design-mode",
          "design-cards",
          "design-writing",
          "design-output"
        ]
      },
      "packs": {
        "design-core": {
          "purpose": "阶段职责、事实源、停止条件和输出边界",
          "sections": [
            "design-analysis-core",
            "design-analysis-boundary",
            "design-methodology-boundary",
            "design-fact-contract",
            "design-business-closure"
          ]
        },
        "design-mode": {
          "purpose": "当前模式的分析责任。必须通过 --mode 选择 simple 或 full",
          "mode_sections": {
            "simple": [
              "design-mode-simple"
            ],
            "full": [
              "design-mode-full",
              "design-card-cross-layer"
            ]
          }
        },
        "design-cards": {
          "purpose": "根据适用性判断装载的专项规则。通过 --card 或 --applicability-json 选择",
          "card_sections": {
            "flow": [
              "design-card-flow"
            ],
            "state": [
              "design-state-example",
              "design-card-state",
              "design-state-snapshot"
            ],
            "page-module": [
              "design-card-page-module"
            ],
            "fields": [
              "design-card-fields",
              "design-card-fields-placement"
            ],
            "permissions": [
              "design-card-permissions"
            ],
            "cross-system": [
              "design-card-cross-layer"
            ],
            "data": [
              "design-card-data"
            ]
          }
        },
        "design-writing": {
          "purpose": "Design 成品组织和表达规则",
          "sections": [
            "design-writing-common-errors",
            "design-writing-structure",
            "design-writing-inference",
            "design-writing-final",
            "design-writing-self-check",
            "design-verification-self-review-boundary",
            "design-verification-self-review"
          ]
        },
        "design-output": {
          "purpose": "Design 多文件输出模板：地图、系统基线、跨模块契约、模块设计",
          "sections": [
            "design-map-template",
            "design-system-template",
            "design-contract-template",
            "design-module-template"
          ]
        },
        "design-verification": {
          "purpose": "规则类型判定、验证包生成与更新、预期来源和独立性",
          "sections": [
            "verification-oracle-rule-types",
            "verification-oracle-evidence",
            "verification-oracle-format",
            "verification-oracle-closure"
          ]
        }
      }
    },
    "prd": {
      "passes": {
        "writing": [
          "prd-core",
          "prd-writing-template",
          "prd-writing-glossary",
          "prd-writing-versioning"
        ],
        "module": [
          "prd-core",
          "prd-cards",
          "prd-writing-examples"
        ]
      },
      "packs": {
        "prd-core": {
          "purpose": "PRD 对象单元写作规范、事实边界和读者任务",
          "sections": [
            "prd-object-unit-spec"
          ]
        },
        "prd-writing-template": {
          "purpose": "PRD 最小骨架模板：writing pass 骨架初始化使用，module pass 不装载",
          "sections": [
            "prd-template"
          ]
        },
        "prd-cards": {
          "purpose": "按适用性装载 PRD 语义自检与数据口径规则",
          "card_sections": {
            "scenes": [
              "prd-verification-scenes"
            ],
            "data": [
              "prd-card-data"
            ]
          }
        },
        "prd-writing-examples": {
          "purpose": "一个真实对象单元样板：只说明组织方式和表达颗粒度，不提供其他项目事实",
          "sections": [
            "prd-object-unit-sample"
          ]
        },
        "prd-writing-glossary": {
          "purpose": "PRD 名词说明格式",
          "sections": [
            "prd-writing-glossary"
          ]
        },
        "prd-writing-versioning": {
          "purpose": "PRD 版本记录格式",
          "sections": [
            "prd-writing-versioning"
          ]
        }
      }
    }
  },
