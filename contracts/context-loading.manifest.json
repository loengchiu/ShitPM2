  "subagent_roles": {
    "material-reader": {
      "purpose": "只提取原始材料事实，不参与设计或写作决策",
      "allowed": {
        "design": {
          "passes": [
            "analysis"
          ],
          "packs": [
            "design-core",
            "design-mode"
          ]
        }
      }
    },
    "design-challenger": {
      "purpose": "对 Design 分析和业务模型做独立挑战，不写最终产物",
      "allowed": {
        "design": {
          "passes": [
            "challenge"
          ],
          "packs": [
            "design-core",
            "design-mode",
            "design-cards"
          ]
        }
      }
    },
    "prd-module-writer": {
      "purpose": "按 Design 已定义业务闭环并行分析单个模块，输出事实要点供主 Agent 直接落盘；不写最终产物、不产生模块草稿、不承担完成条件",
      "allowed": {
        "prd": {
          "passes": [
            "module"
          ],
          "packs": [
            "prd-core",
            "prd-writing-structure",
            "prd-writing-action",
            "prd-cards"
          ]
        }
      }
    }
  }
