{
  "version": 1,
  "description": "ShitPM Design / PRD 编译式上下文装载清单。规范性规则由显式 pack 和稳定章节标记选择，不使用相似度检索决定强制装载。",
  "stages": {
    "align": {
      "passes": {
        "analysis": [
          "align-core"
        ]
      },
      "packs": {
        "align-core": {
          "purpose": "需求事实形成、材料详细保留、问答写回和高影响未知处理",
          "sections": [
            "align-writing-core",
            "align-writing-detail",
            "align-template"
          ]
        }
      }
    },
    "design": {
      "passes": {
        "analysis": [
          "design-core",
          "design-mode"
        ],
        "challenge": [
          "design-core",
          "design-mode",
          "design-cards"
        ],
        "writing": [
          "design-core",
          "design-mode",
          "design-cards",
          "design-writing",
          "design-output"
        ]
      },
      "packs": {
        "design-core": {
          "purpose": "阶段职责、事实源、停止条件和输出边界",
          "sections": [
            "design-analysis-core",
            "design-analysis-boundary",
            "design-methodology-boundary",
            "design-asset-contract",
            "design-fact-contract"
          ]
        },
        "design-mode": {
          "purpose": "当前模式的分析责任。必须通过 --mode 选择 simple 或 full",
          "mode_sections": {
            "simple": [
              "design-mode-simple"
            ],
            "full": [
              "design-mode-full",
              "design-card-cross-layer"
            ]
          }
        },
        "design-cards": {
          "purpose": "根据适用性判断装载的专项规则。通过 --card 或 --applicability-json 选择",
          "card_sections": {
            "flow": [
              "design-card-flow"
            ],
            "state": [
              "design-state-example",
              "design-card-state",
              "design-state-snapshot"
            ],
            "page-module": [
              "design-card-page-module"
            ],
            "fields": [
              "design-card-fields",
              "design-card-fields-placement"
            ],
            "permissions": [
              "design-card-permissions"
            ],
            "cross-system": [
              "design-card-cross-layer"
            ]
          }
        },
        "design-writing": {
          "purpose": "Design 成品组织和表达规则",
          "sections": [
            "design-writing-common-errors",
            "design-writing-structure",
            "design-writing-final",
            "design-verification-self-review-boundary",
            "design-verification-self-review"
          ]
        },
        "design-output": {
          "purpose": "Design 输出模板和审计记录模板",
          "sections": [
            "design-template",
            "decision-notes-template"
          ]
        },
        "design-compatibility": {
          "purpose": "旧项目 metadata 兼容规则，仅检测到旧 metadata 时显式装载",
          "sections": [
            "metadata-anchor-rules"
          ]
        }
      }
    },
    "prd": {
      "passes": {
        "writing": [
          "prd-core",
          "prd-writing-structure",
          "prd-writing-action",
          "prd-writing-glossary",
          "prd-writing-versioning",
          "prd-verification"
        ],
        "module": [
          "prd-core",
          "prd-writing-structure",
          "prd-writing-action",
          "prd-cards"
        ]
      },
      "packs": {
        "prd-core": {
          "purpose": "PRD 与 Design 的边界、交付约束和机读约束",
          "sections": [
            "prd-core-boundary"
          ]
        },
        "prd-cards": {
          "purpose": "按适用性装载 PRD 专项场景规则",
          "card_sections": {
            "scenes": [
              "prd-verification-scenes"
            ]
          }
        },
        "prd-verification": {
          "purpose": "PRD 生成内场景覆盖和交付检查",
          "sections": [
            "prd-verification-scenes"
          ]
        },
        "prd-writing-structure": {
          "purpose": "PRD 结构、页面组织、字段表和状态机的组织规则，以及输出模板和机读约束",
          "sections": [
            "prd-writing-structure",
            "prd-template",
            "prd-profile"
          ]
        },
        "prd-writing-action": {
          "purpose": "PRD 动作正文和具体写作要求",
          "sections": [
            "prd-writing-action"
          ]
        },
        "prd-writing-glossary": {
          "purpose": "PRD 名词说明格式",
          "sections": [
            "prd-writing-glossary"
          ]
        },
        "prd-writing-versioning": {
          "purpose": "PRD 版本记录格式",
          "sections": [
            "prd-writing-versioning"
          ]
        }
      }
    }
  },
