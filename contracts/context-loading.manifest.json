  "subagent_roles": {
    "material-reader": {
      "purpose": "只提取原始材料事实，不参与设计或写作决策",
      "allowed": {
        "design": {
          "passes": [
            "analysis"
          ],
          "packs": [
            "design-core",
            "design-mode"
          ]
        },
        "prd": {
          "passes": [
            "plan"
          ],
          "packs": [
            "prd-core",
            "prd-writing-structure"
          ]
        }
      }
    },
    "design-challenger": {
      "purpose": "对 Design 分析和业务模型做独立挑战，不写最终产物",
      "allowed": {
        "design": {
          "passes": [
            "challenge"
          ],
          "packs": [
            "design-core",
            "design-mode",
            "design-cards"
          ]
        }
      }
    },
    "prd-module-writer": {
      "purpose": "按 Design 已定义业务模块生成内部 PRD 草稿",
      "allowed": {
        "prd": {
          "passes": [
            "module"
          ],
          "packs": [
            "prd-core",
            "prd-writing-structure",
            "prd-writing-action",
            "prd-examples",
            "prd-cards"
          ]
        }
      }
    },
    "module-verifier": {
      "purpose": "检查模块草稿遗漏、冲突和来源，不补写高影响事实",
      "allowed": {
        "prd": {
          "passes": [
            "verification"
          ],
          "packs": [
            "prd-core",
            "prd-writing-structure",
            "prd-writing-action",
            "prd-verification"
          ]
        }
      }
    }
  }
}
