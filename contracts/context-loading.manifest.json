{
  "version": 1,
  "description": "ShitPM Design / PRD 编译式上下文装载清单。规范性规则由显式 pack 和稳定章节标记选择，不使用相似度检索决定强制装载。",
  "stages": {
    "align": {
      "passes": {
        "analysis": [
          "align-core"
        ]
      },
      "packs": {
        "align-core": {
          "purpose": "需求事实形成、材料详细保留、问答写回和高影响未知处理",
          "sections": [
            "align-writing-core",
            "align-writing-detail",
            "align-template"
          ]
        }
      }
    },
    "design": {
      "passes": {
        "analysis": [
          "design-core",
          "design-mode"
        ],
        "challenge": [
          "design-core",
          "design-mode",
          "design-cards"
        ],
        "writing": [
          "design-core",
          "design-mode",
          "design-cards",
          "design-writing",
          "design-output"
        ]
      },
      "packs": {
        "design-core": {
          "purpose": "阶段职责、事实源、停止条件和输出边界",
          "sections": [
            "design-analysis-core",
            "design-analysis-boundary",
            "design-methodology-boundary",
            "design-asset-contract",
            "design-fact-contract"
          ]
        },
        "design-mode": {
          "purpose": "当前模式的分析责任。必须通过 --mode 选择 simple 或 full",
          "mode_sections": {
            "simple": [
              "design-mode-simple"
            ],
            "full": [
              "design-mode-full",
              "design-card-cross-layer"
            ]
          }
        },
        "design-cards": {
          "purpose": "根据适用性判断装载的专项规则。通过 --card 或 --applicability-json 选择",
          "card_sections": {
            "flow": [
              "design-card-flow"
            ],
            "state": [
              "design-state-example",
              "design-card-state",
              "design-state-snapshot"
            ],
            "page-module": [
              "design-card-page-module"
            ],
            "fields": [
              "design-card-fields",
              "design-card-fields-placement"
            ],
            "permissions": [
              "design-card-permissions"
            ],
            "cross-system": [
              "design-card-cross-layer"
            ]
          }
        },
        "design-writing": {
          "purpose": "Design 成品组织和表达规则",
          "sections": [
            "design-writing-common-errors",
            "design-writing-structure",
            "design-writing-final",
            "design-writing-self-check",
            "design-verification-self-review-boundary",
            "design-verification-self-review"
          ]
        },
        "design-output": {
          "purpose": "Design 输出模板和审计记录模板",
          "sections": [
            "design-template",
            "decision-notes-template"
          ]
        }
      }
    },
    "prd": {
      "passes": {
        "writing": [
          "prd-core",
          "prd-writing-structure",
          "prd-writing-template",
          "prd-writing-glossary",
          "prd-writing-versioning"
        ],
        "module": [
          "prd-core",
          "prd-writing-spec",
          "prd-cards",
          "prd-writing-examples"
        ]
      },
      "packs": {
        "prd-core": {
          "purpose": "PRD 与 Design 的边界、交付约束和机读约束",
          "sections": [
            "prd-core-boundary"
          ]
        },
        "prd-writing-structure": {
          "purpose": "PRD 顶层结构和模块固定子章节的最小结构规则（writing pass 骨架初始化）",
          "sections": [
            "prd-writing-structure"
          ]
        },
        "prd-writing-template": {
          "purpose": "PRD 最小骨架模板：writing pass 骨架初始化使用，module pass 不装载",
          "sections": [
            "prd-template"
          ]
        },
        "prd-writing-spec": {
          "purpose": "详细需求说明（4.x.6）唯一写作规范：模块组织、页面判断链、动作重组与复杂度、数据口径、事实边界和信息密度",
          "sections": [
            "prd-writing-spec"
          ]
        },
        "prd-cards": {
          "purpose": "按适用性装载 PRD 精简语义自检问题",
          "card_sections": {
            "scenes": [
              "prd-verification-scenes"
            ]
          }
        },
        "prd-writing-examples": {
          "purpose": "详细需求说明写作示例：目标颗粒度和表达方式的必要输入，不提供产品事实。模块写作自动装载简单只读和多角色状态示例，分别展示篇幅下限和复杂页面的完整颗粒度；其他类型用 --example 按需装载",
          "sections": [
            "prd-example-simple-readonly",
            "prd-example-multi-role-state"
          ],
          "example_sections": {
            "dashboard": [
              "prd-example-dashboard"
            ],
            "list-detail-query": [
              "prd-example-list-detail-query"
            ],
            "form-config": [
              "prd-example-form-config"
            ],
            "multi-role-state": [
              "prd-example-multi-role-state"
            ],
            "mobile-cross-terminal": [
              "prd-example-mobile-cross-terminal"
            ],
            "external-auto": [
              "prd-example-external-auto"
            ],
            "simple-readonly": [
              "prd-example-simple-readonly"
            ]
          }
        },
        "prd-writing-glossary": {
          "purpose": "PRD 名词说明格式",
          "sections": [
            "prd-writing-glossary"
          ]
        },
        "prd-writing-versioning": {
          "purpose": "PRD 版本记录格式",
          "sections": [
            "prd-writing-versioning"
          ]
        }
      }
    }
  },
