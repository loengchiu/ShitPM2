{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "ShitPM Common Definitions",
  "description": "跨 schema 共享的枚举定义，各阶段 schema 通过 $ref 引用，避免重复",
  "$defs": {
    "verdict_enum": {
      "type": "string",
      "enum": ["通过", "有问题需修改", "阻塞"],
      "description": "review 结论三档"
    },
    "review_stage_enum": {
      "type": "string",
      "enum": ["design", "prd", "prototype"],
      "description": "被 review 的阶段"
    },
    "relation_type_enum": {
      "type": "string",
      "enum": ["derived_from", "refines", "depends_on", "contains", "uses", "verifies"],
      "description": "关系类型"
    }
  }
}
