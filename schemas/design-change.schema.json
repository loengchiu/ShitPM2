{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "design-change.schema.json",
  "title": "DesignChange",
  "description": "Design 修改事务：登记单文件快速路径或多文件保护路径的目标文件、指纹和受影响的 artifacts。只处理确定性文件关系，不判断业务语义。",
  "type": "object",
  "required": ["schema_version", "mode", "phase", "files", "artifacts"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["shitpm-design-change/v1"]
    },
    "mode": {
      "type": "string",
      "enum": ["single", "multi"],
      "description": "single 时 files 必须恰好一个目标"
    },
    "phase": {
      "type": "string",
      "enum": ["staging", "replacing", "verifying"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "before_sha256", "staged_sha256"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(MAP|SYS|CON|MOD)-\d{3}$"
          },
          "path": { "type": "string" },
          "before_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$",
            "description": "新增文件为 null"
          },
          "staged_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$",
            "description": "删除文件为 null"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "before_sha256", "staged_sha256"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["manifest", "prd_provenance", "prototype_provenance"]
          },
          "path": {
            "type": "string",
            "description": "只允许指向设计集清单或两份 provenance"
          },
          "before_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "staged_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
