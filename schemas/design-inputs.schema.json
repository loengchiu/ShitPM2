{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "design-inputs.schema.json",
  "title": "DesignInputs",
  "description": "下游 Design 依据：PRD 或 Prototype 某业务模块实际读取的 Design 文件 ID 和指纹。只记录定位和影响，不保存业务正文，不构成第二事实源。",
  "type": "object",
  "required": ["schema_version", "artifact", "targets"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["shitpm-design-inputs/v1"]
    },
    "artifact": {
      "type": "string",
      "enum": ["prd", "prototype"]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_id", "target_name", "output_path", "output_locator", "status", "check_status", "affected_by", "design_inputs"],
        "properties": {
          "target_id": {
            "type": "string",
            "description": "在对应下游内唯一"
          },
          "target_name": { "type": "string" },
          "output_path": {
            "type": "string",
            "description": "下游产物路径（项目相对）"
          },
          "output_locator": {
            "type": "string",
            "description": "PRD 使用模块标题，Prototype 使用路由或源码模块目录"
          },
          "status": {
            "type": "string",
            "enum": ["current", "affected", "incomplete"]
          },
          "check_status": {
            "type": "string",
            "enum": ["passed", "failed", "not_run"]
          },
          "affected_by": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(MAP|SYS|CON|MOD)-\d{3}$"
            },
            "description": "只保存发生变化的 Design 文件 ID"
          },
          "design_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "sha256"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(MAP|SYS|CON|MOD)-\d{3}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
