{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesignMetadata",
  "description": "design 阶段机读镜像的公共结构定义（文档性契约：当前无脚本强制校验此文件；vNext 主流程不依赖 metadata，仅作为机读镜像结构约定供维护者参考）",
  "type": "object",
  "required": ["schema_version", "stage", "artifact_path", "generated_at", "entity_count", "relation_count"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "schema 版本号"
    },
    "stage": {
      "type": "string",
      "const": "design",
      "description": "所属阶段"
    },
    "artifact_path": {
      "type": "string",
      "description": "人读产物路径"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 生成时间戳"
    },
    "entity_count": {
      "type": "integer",
      "description": "实体总数（含 modules/pages/fields/rules/flows/states/permissions）"
    },
    "relation_count": {
      "type": "integer",
      "description": "关系总数"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(MODULE|PAGE|FIELD|RULE|FLOW|STATE|PERM)-design-[0-9]{3}$",
          "description": "稳定 ID，仅存在于机读物"
        },
        "type": {
          "type": "string",
          "enum": ["module", "page", "field", "rule", "flow", "state", "permission"],
          "description": "实体类型"
        },
        "title": { "type": "string", "description": "实体标题" },
        "source_ref": { "type": ["string", "null"], "description": "来源追溯" },
        "attributes": { "type": "object", "description": "实体属性" }
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": ["id", "type", "from", "to"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REL-design-[0-9]{3}$"
        },
        "type": { "$ref": "common.schema.json#/$defs/relation_type_enum" },
        "from": { "type": "string", "description": "来源实体 ID" },
        "to": { "type": "string", "description": "目标实体 ID" }
      },
      "additionalProperties": false
    }
  }
}
