{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRDMetadata",
  "description": "PRD 阶段机读镜像 index.json 的结构定义",
  "type": "object",
  "required": ["schema_version", "stage", "artifact_path", "generated_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "stage": { "type": "string", "const": "prd" },
    "artifact_path": { "type": "string" },
    "generated_at": { "type": "string", "description": "ISO 8601 生成时间戳" }
  },
  "additionalProperties": true,
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^(MODULE|PAGE|FIELD|RULE|FLOW|STATE|PERM)-design-[0-9]{3}$" },
        "type": { "type": "string", "enum": ["module", "page", "field", "rule", "flow", "state", "permission"] },
        "title": { "type": "string" },
        "source_ref": { "type": ["string", "null"] },
        "attributes": { "type": "object" }
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": ["id", "type", "from", "to"],
      "properties": {
        "id": { "type": "string", "pattern": "^REL-design-[0-9]{3}$" },
        "type": { "$ref": "common.schema.json#/$defs/relation_type_enum" },
        "from": { "type": "string" },
        "to": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
