{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrototypeMetadata",
  "description": "prototype 阶段机读镜像的结构定义",
  "type": "object",
  "required": ["schema_version", "stage", "artifact_path", "entity_count", "relation_count"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "stage": { "type": "string", "const": "prototype" },
    "artifact_path": { "type": "string" },
    "generated_at": { "type": "string", "description": "ISO 8601 生成时间戳" },
    "entity_count": { "type": "integer", "const": 0, "description": "prototype 阶段无实体" },
    "relation_count": { "type": "integer", "const": 0, "description": "prototype 阶段无关系" }
  },
  "additionalProperties": true
}
